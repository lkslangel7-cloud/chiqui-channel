  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 56.0,
      "end": 59.1,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 59.1,
      "end": 61.8,
      "text": "장난감은 제자리! (제자리!)"
    },
    {
      "at": 61.8,
      "end": 63.8,
      "text": "친구들아 같이 하자"
    },
    {
      "at": 63.8,
      "end": 66.4,
      "text": "치키치키 정리!"
    },
    {
      "at": 66.4,
      "end": 68.9,
      "text": "공을 굴려 데굴데굴"
    },
    {
      "at": 68.9,
      "end": 70.4,
      "text": "크앙! 로로가 쏙"
    },
    {
      "at": 70.4,
      "end": 75.3,
      "text": "노란 상자에 쏙 (쏙!)"
    },
    {
      "at": 75.6,
      "end": 78.6,
      "text": "블록 높이 차곡차곡"
    },
    {
      "at": 78.6,
      "end": 80.5,
      "text": "쭈욱~ 토롱이 쏙"
    },
    {
      "at": 80.5,
      "end": 85.3,
      "text": "초록 상자에 쏙 (쏙!)"
    },
    {
      "at": 85.6,
      "end": 89.2,
      "text": "비행기가 슝슝슝"
    },
    {
      "at": 89.2,
      "end": 91.0,
      "text": "슝~ 피오가 쏙"
    },
    {
      "at": 91.0,
      "end": 95.5,
      "text": "파란 상자에 쏙 (쏙!)"
    },
    {
      "at": 95.8,
      "end": 98.3,
      "text": "치키 자동차 부릉부릉"
    },
    {
      "at": 98.3,
      "end": 101.1,
      "text": "내 상자는 어디? (어디 있지?)"
    },
    {
      "at": 101.1,
      "end": 105.4,
      "text": "주황 주황 내 상자 (어디?)"
    },
    {
      "at": 105.7,
      "end": 108.2,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 108.2,
      "end": 110.6,
      "text": "장난감은 제자리! (제자리!)"
    },
    {
      "at": 110.6,
      "end": 113.0,
      "text": "친구들아 같이 하자"
    },
    {
      "at": 113.0,
      "end": 115.7,
      "text": "치키치키 정리!"
    },
    {
      "at": 161.4,
      "end": 164.8,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 164.8,
      "end": 167.8,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 167.8,
      "end": 172.8,
      "text": "안녕! 바이바이! 아디오스!"
    },
    {
      "at": 172.8,
      "end": 176.9,
      "text": "내일 또 만나요, 크앙!"
    }
