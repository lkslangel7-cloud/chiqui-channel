  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 55.9,
      "end": 58.3,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 58.3,
      "end": 61.5,
      "text": "발자국 누구 거니? (어디 있니?)"
    },
    {
      "at": 61.5,
      "end": 62.9,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 62.9,
      "end": 66.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 66.3,
      "end": 68.4,
      "text": "콩콩 콩콩 세 발가락"
    },
    {
      "at": 68.4,
      "end": 70.8,
      "text": "크앙! 로로 발자국"
    },
    {
      "at": 70.8,
      "end": 75.0,
      "text": "딱 맞았다 (맞았다!)"
    },
    {
      "at": 75.3,
      "end": 77.9,
      "text": "쿵쿵 쿵쿵 커다란 발"
    },
    {
      "at": 77.9,
      "end": 80.3,
      "text": "쭈욱~ 토롱 발자국"
    },
    {
      "at": 80.3,
      "end": 84.0,
      "text": "딱 맞았다 (맞았다!)"
    },
    {
      "at": 84.3,
      "end": 87.3,
      "text": "총총 총총 조그만 발"
    },
    {
      "at": 87.3,
      "end": 89.7,
      "text": "슝~ 피오 발자국"
    },
    {
      "at": 89.7,
      "end": 93.7,
      "text": "딱 맞았다 (맞았다!)"
    },
    {
      "at": 94.0,
      "end": 97.5,
      "text": "치키 발자국 어디 있니?"
    },
    {
      "at": 97.5,
      "end": 99.6,
      "text": "두리번 두리번 (어디 있지?)"
    },
    {
      "at": 99.6,
      "end": 104.2,
      "text": "내 발자국 (어디?)"
    },
    {
      "at": 104.5,
      "end": 107.1,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 107.1,
      "end": 109.7,
      "text": "발자국 누구 거니? (어디 있니?)"
    },
    {
      "at": 109.7,
      "end": 112.0,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 112.0,
      "end": 115.6,
      "text": "치키치키 출발!"
    },
    {
      "at": 161.3,
      "end": 164.7,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 164.7,
      "end": 167.7,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 167.7,
      "end": 172.7,
      "text": "안녕! 바이바이! 아디오스!"
    },
    {
      "at": 172.7,
      "end": 176.8,
      "text": "내일 또 만나요, 크앙!"
    }
  ],
