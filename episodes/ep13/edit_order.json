  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 55.6,
      "end": 58.5,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 58.5,
      "end": 61.3,
      "text": "아~ 해 보세요! (아~!)"
    },
    {
      "at": 61.3,
      "end": 63.7,
      "text": "하나도 안 무서워"
    },
    {
      "at": 63.7,
      "end": 64.8,
      "text": "치키치키 튼튼!"
    },
    {
      "at": 64.8,
      "end": 69.4,
      "text": "키 재기 쭈욱쭈욱"
    },
    {
      "at": 69.4,
      "end": 71.0,
      "text": "토롱이 제일 커"
    },
    {
      "at": 71.0,
      "end": 76.7,
      "text": "쭉쭉 컸네 (와!)"
    },
    {
      "at": 77.4,
      "end": 79.8,
      "text": "콩닥콩닥 청진기"
    },
    {
      "at": 79.8,
      "end": 82.1,
      "text": "치키 마음 소리"
    },
    {
      "at": 82.1,
      "end": 85.3,
      "text": "콩닥콩닥 (콩닥!)"
    },
    {
      "at": 86.0,
      "end": 90.7,
      "text": "입을 크게 아~"
    },
    {
      "at": 90.7,
      "end": 93.7,
      "text": "피오도 아~"
    },
    {
      "at": 93.7,
      "end": 98.3,
      "text": "아~ 잘했어요 (아~!)"
    },
    {
      "at": 99.2,
      "end": 101.8,
      "text": "로로 차례 두근두근"
    },
    {
      "at": 101.8,
      "end": 104.6,
      "text": "눈을 꼭 감고 (할 수 있어!)"
    },
    {
      "at": 104.6,
      "end": 109.3,
      "text": "하나도 안 아파 (짝짝!)"
    },
    {
      "at": 110.1,
      "end": 112.8,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 112.8,
