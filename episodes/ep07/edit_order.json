  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 56.5,
      "end": 59.1,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 59.1,
      "end": 61.9,
      "text": "사과야 어디 있니? (어디 있니?)"
    },
    {
      "at": 61.9,
      "end": 64.1,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 64.1,
      "end": 66.6,
      "text": "치키치키 출발!"
    },
    {
      "at": 66.6,
      "end": 69.3,
      "text": "낮은 가지 동글동글"
    },
    {
      "at": 69.3,
      "end": 71.4,
      "text": "크앙! 로로가 땄어요"
    },
    {
      "at": 71.4,
      "end": 73.8,
      "text": "하나, 둘 (둘!)"
    },
    {
      "at": 74.1,
      "end": 76.8,
      "text": "높은 가지 동글동글"
    },
    {
      "at": 76.8,
      "end": 79.2,
      "text": "쭈욱~ 토롱이 땄어요"
    },
    {
      "at": 79.2,
      "end": 81.5,
      "text": "셋, 넷 (넷!)"
    },
    {
      "at": 81.8,
      "end": 84.3,
      "text": "꼭대기에 동글동글"
    },
    {
      "at": 84.3,
      "end": 86.4,
      "text": "슝~ 피오가 땄어요"
    },
    {
      "at": 86.4,
      "end": 89.0,
      "text": "다섯, 여섯 (여섯!)"
    },
    {
      "at": 89.3,
      "end": 91.8,
      "text": "폴짝 뛰어 동글동글"
    },
    {
      "at": 91.8,
      "end": 94.0,
      "text": "짠! 치키가 땄어요"
    },
    {
      "at": 94.0,
      "end": 96.3,
      "text": "일곱, 여덟 (여덟!)"
    },
    {
      "at": 96.6,
      "end": 99.3,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 99.3,
      "end": 101.8,
      "text": "사과야 어디 있니? (어디 있니?)"
    },
    {
      "at": 101.8,
      "end": 104.2,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 104.2,
      "end": 107.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 153.0,
      "end": 156.4,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 156.4,
      "end": 159.4,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 159.4,
      "end": 164.4,
      "text": "안녕! 바이바이! 아디오스!"
    },
    {
      "at": 164.4,
      "end": 168.5,
      "text": "내일 또 만나요, 크앙!"
    }
  ],
