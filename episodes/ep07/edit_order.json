      "who": "바우 할아버지",
      "text": "사과 열 개 따러 가자!"
    },
    {
      "at": 31.5,
      "audio": "audio/ko/02_chiqui.wav",
      "who": "치키",
      "text": "와, 사과 나무다!"
    },
    {
      "at": 45.8,
      "audio": "audio/ko/03_chiqui.wav",
      "who": "치키",
      "text": "친구들아, 같이 따자!"
    },
    {
      "at": 50.8,
      "audio": "audio/ko/04_all.wav",
      "who": "모두",
      "text": "좋아!"
    },
    {
      "at": 108.1,
      "audio": "audio/ko/05_narr.wav",
      "who": "내레이션",
      "text": "몇 개 남았을까?"
    },
    {
      "at": 115.1,
      "audio": "audio/ko/06_bau.wav",
      "who": "바우 할아버지",
      "text": "아홉, 열!"
    },
    {
      "at": 122.9,
      "audio": "audio/ko/07_narr.wav",
      "who": "내레이션",
      "text": "다 같이 세어 볼까?"
    },
    {
      "at": 124.6,
      "audio": "audio/ko/08_all.wav",
      "who": "모두",
      "text": "하나, 둘, 셋, 넷, 다섯, 여섯, 일곱, 여덟, 아홉, 열!"
    },
    {
      "at": 134.6,
      "audio": "audio/ko/09_bau.wav",
      "who": "바우 할아버지",
      "text": "다 같이 모으니 열 개!"
    },
    {
      "at": 137.9,
      "audio": "audio/ko/10_all.wav",
      "who": "모두",
      "text": "와아~"
    },
    {
      "at": 143.6,
      "audio": "audio/ko/11_all.wav",
      "who": "모두",
      "text": "냠냠, 맛있다!"
    },
