  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 55.3,
      "end": 58.0,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 58.0,
      "end": 60.9,
      "text": "무지개야 어디 있니? (어디 있니?)"
    },
    {
      "at": 60.9,
      "end": 62.9,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 62.9,
      "end": 65.2,
      "text": "치키치키 출발!"
    },
    {
      "at": 65.6,
      "end": 68.2,
      "text": "웅덩이에 첨벙첨벙"
    },
    {
      "at": 68.2,
      "end": 70.4,
      "text": "크앙! 로로가 웃어요"
    },
    {
      "at": 70.4,
      "end": 72.7,
      "text": "기분이 좋아 (하하!)"
    },
    {
      "at": 72.9,
      "end": 75.0,
      "text": "나무 위로 쭈욱쭈욱"
    },
    {
      "at": 75.0,
      "end": 78.0,
      "text": "토롱이 살펴봐요"
    },
    {
      "at": 78.0,
      "end": 80.5,
      "text": "아직 없네 (어디?)"
    },
    {
      "at": 80.8,
      "end": 82.4,
      "text": "구름 위로 슝슝슝"
    },
    {
      "at": 82.4,
      "end": 85.4,
      "text": "피오가 찾았다"
    },
    {
      "at": 85.4,
      "end": 87.9,
      "text": "저기 무지개 (와아!)"
    },
    {
      "at": 88.0,
      "end": 90.1,
      "text": "치키도 보고 싶어"
    },
    {
      "at": 90.1,
      "end": 92.7,
      "text": "폴짝폴짝 (안 보여)"
    },
    {
      "at": 92.7,
      "end": 95.4,
      "text": "조금 속상해 (힝!)"
    },
    {
      "at": 95.5,
      "end": 98.0,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 98.0,
      "end": 100.9,
      "text": "무지개야 어디 있니? (어디 있니?)"
    },
    {
      "at": 100.9,
      "end": 102.9,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 102.9,
      "end": 105.4,
      "text": "치키치키 출발!"
    },
    {
      "at": 150.4,
      "end": 153.8,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 153.8,
      "end": 156.8,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 156.8,
      "end": 161.8,
      "text": "안녕! 바이바이! 아디오스!"
    },
