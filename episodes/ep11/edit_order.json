  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 54.0,
      "end": 56.8,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 56.8,
      "end": 59.7,
      "text": "골고루 냠냠! (냠냠!)"
    },
    {
      "at": 59.7,
      "end": 61.7,
      "text": "한 입 두 입 맛있게"
    },
    {
      "at": 61.7,
      "end": 63.9,
      "text": "치키치키 냠냠!"
    },
    {
      "at": 63.9,
      "end": 66.0,
      "text": "노란 옥수수 톡톡톡"
    },
    {
      "at": 66.0,
      "end": 68.0,
      "text": "크앙! 로로가 와앙"
    },
    {
      "at": 68.0,
      "end": 71.3,
      "text": "옥수수 냠냠 (냠냠!)"
    },
    {
      "at": 71.6,
      "end": 74.1,
      "text": "초록 브로콜리 작은 나무"
    },
    {
      "at": 74.1,
      "end": 76.1,
      "text": "쭈욱~ 토롱이 냠"
    },
    {
      "at": 76.1,
      "end": 79.4,
      "text": "브로콜리 냠냠 (냠냠!)"
    },
    {
      "at": 79.7,
      "end": 82.3,
      "text": "파란 블루베리 콩콩콩"
    },
    {
      "at": 82.3,
      "end": 83.8,
      "text": "슝~ 피오가 콕"
    },
    {
      "at": 83.8,
      "end": 87.6,
      "text": "블루베리 냠냠 (냠냠!)"
    },
    {
      "at": 87.9,
      "end": 90.6,
      "text": "치키도 한 입 해 볼까?"
    },
    {
      "at": 90.6,
      "end": 92.7,
      "text": "망설망설 (할 수 있어!)"
    },
    {
      "at": 92.7,
      "end": 95.9,
      "text": "한 입만 냠 (냠!)"
    },
    {
      "at": 96.2,
      "end": 97.7,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 97.7,
      "end": 100.6,
      "text": "골고루 냠냠! (냠냠!)"
    },
    {
      "at": 100.6,
      "end": 102.7,
      "text": "한 입 두 입 맛있게"
    },
    {
      "at": 102.7,
      "end": 105.7,
      "text": "치키치키 냠냠!"
    },
    {
      "at": 151.4,
      "end": 154.8,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 154.8,
      "end": 157.8,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 157.8,
      "end": 162.8,
      "text": "안녕! 바이바이! 아디오스!"
    },
    {
      "at": 162.8,
      "end": 166.9,
      "text": "내일 또 만나요, 크앙!"
    }
