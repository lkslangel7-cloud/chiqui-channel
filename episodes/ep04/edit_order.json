  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 54.7,
      "end": 58.1,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 58.1,
      "end": 60.2,
      "text": "친구야 어디 있니? (어디 있니?)"
    },
    {
      "at": 60.2,
      "end": 62.5,
      "text": "하나 둘 셋 넷 다섯"
    },
    {
      "at": 62.5,
      "end": 64.8,
      "text": "치키치키 출발!"
    },
    {
      "at": 65.0,
      "end": 67.5,
      "text": "바위 뒤에 살금살금"
    },
    {
      "at": 67.5,
      "end": 69.7,
      "text": "크앙! 로로 꼬리 보여"
    },
    {
      "at": 69.7,
      "end": 74.2,
      "text": "로로 찾았다 (찾았다!)"
    },
    {
      "at": 75.2,
      "end": 77.4,
      "text": "나무 뒤에 살금살금"
    },
    {
      "at": 77.4,
      "end": 79.6,
      "text": "쭈욱~ 토롱 목이 보여"
    },
    {
      "at": 79.6,
      "end": 84.0,
      "text": "토롱 찾았다 (찾았다!)"
    },
    {
      "at": 84.6,
      "end": 87.1,
      "text": "꽃잎 속에 살금살금"
    },
    {
      "at": 87.1,
      "end": 89.6,
      "text": "쉿~ 피오는 작아요"
    },
    {
      "at": 89.6,
      "end": 94.0,
      "text": "피오 찾았다 (찾았다!)"
    },
    {
      "at": 94.6,
      "end": 97.1,
      "text": "할아버지 어디 있니?"
    },
    {
      "at": 97.1,
      "end": 99.6,
      "text": "덤불 뒤에 (허허!)"
    },
    {
      "at": 99.6,
      "end": 104.2,
      "text": "다 보여요 할아버지 (찾았다!)"
    },
    {
      "at": 104.6,
      "end": 106.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 106.6,
      "end": 108.6,
      "text": "친구야 어디 있니?"
    },
    {
      "at": 110.3,
      "end": 111.6,
      "text": "하나 둘 셋 넷 다섯"
    },
    {
      "at": 111.6,
      "end": 114.6,
      "text": "치키치키 출발!"
    },
    {
      "at": 160.4,
      "end": 163.8,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 163.8,
      "end": 166.8,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 166.8,
      "end": 171.8,
      "text": "안녕! 바이바이! 아디오스!"
    },
    {
      "at": 171.8,
      "end": 175.9,
      "text": "내일 또 만나요, 크앙!"
    }
