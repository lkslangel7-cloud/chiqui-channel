  "lines": [
    {
      "at": 21.0,
      "audio": "audio/ko/01_chiqui.wav",
      "who": "치키",
      "text": "더 놀고 싶어!"
    },
    {
      "at": 31.0,
      "audio": "audio/ko/02_bau.wav",
      "who": "바우 할아버지",
      "text": "해님도 코~ 자러 가네."
    },
    {
      "at": 36.0,
      "audio": "audio/ko/03_chiqui.wav",
      "who": "치키",
      "text": "어? 달님이 없다!"
    },
    {
      "at": 41.0,
      "audio": "audio/ko/04_chiqui.wav",
      "who": "치키",
      "text": "친구들아, 같이 찾자!"
    },
    {
      "at": 46.0,
      "audio": "audio/ko/05_all.wav",
      "who": "모두",
      "text": "좋아!"
    },
    {
      "at": 116.7,
      "audio": "audio/ko/06_narr.wav",
      "who": "내레이션",
      "text": "달님은 어디 있을까?"
    },
    {
      "at": 125.5,
      "audio": "audio/ko/07_chiqui.wav",
      "who": "치키",
      "text": "달님이다! 구름 뒤에 숨어 있었네!"
    },
    {
      "at": 128.8,
      "audio": "audio/ko/08_all.wav",
      "who": "모두",
      "text": "와아~"
    },
    {
      "at": 132.2,
      "audio": "audio/ko/09_bau.wav",
      "who": "바우 할아버지",
      "text": "구름에 가려도, 달님은 늘 있단다."
    },
    {
      "at": 142.2,
      "audio": "audio/ko/10_all.wav",
      "who": "모두",
      "text": "달님, 잘 자!"
    },
    {
      "at": 152.7,
      "audio": "audio/ko/11_narr.wav",
      "who": "내레이션",
      "text": "쉿, 잘 자요."
