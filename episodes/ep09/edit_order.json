  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 56.1,
      "end": 58.8,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 58.8,
      "end": 61.9,
      "text": "달님 어디 있니? (어디 있니?)"
    },
    {
      "at": 61.9,
      "end": 63.8,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 63.8,
      "end": 66.4,
      "text": "치키치키 출발!"
    },
    {
      "at": 66.4,
      "end": 68.8,
      "text": "바위 뒤에 반짝반짝"
    },
    {
      "at": 68.8,
      "end": 71.2,
      "text": "크앙! 로로가 찾았다"
    },
    {
      "at": 71.2,
      "end": 75.9,
      "text": "반딧불이 (반짝!)"
    },
    {
      "at": 76.2,
      "end": 78.8,
      "text": "나무 위에 반짝반짝"
    },
    {
      "at": 78.8,
      "end": 81.1,
      "text": "쭈욱~ 토롱이 찾았다"
    },
    {
      "at": 81.1,
      "end": 85.9,
      "text": "작은 별님 (반짝!)"
    },
    {
      "at": 86.2,
      "end": 88.6,
      "text": "구름 위에 반짝반짝"
    },
    {
      "at": 88.6,
      "end": 91.0,
      "text": "슝~ 피오가 찾았다"
    },
    {
      "at": 91.0,
      "end": 95.8,
      "text": "별님 하나 더 (반짝!)"
    },
    {
      "at": 96.1,
      "end": 98.7,
      "text": "달님 달님 어디 있니?"
    },
    {
      "at": 98.7,
      "end": 101.2,
      "text": "두리번 두리번 (어디 있지?)"
    },
    {
      "at": 101.2,
      "end": 105.7,
      "text": "구름 뒤에 숨었나? (어디?)"
    },
    {
      "at": 106.0,
      "end": 108.3,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 108.3,
      "end": 110.6,
      "text": "달님 어디 있니? (어디 있니?)"
    },
    {
      "at": 110.6,
      "end": 113.3,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 113.3,
      "end": 115.9,
      "text": "치키치키 출발!"
    },
    {
      "at": 161.6,
      "end": 165.0,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 165.0,
      "end": 168.0,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 168.0,
      "end": 173.0,
      "text": "안녕! 바이바이! 아디오스!"
    },
    {
      "at": 173.0,
      "end": 177.1,
      "text": "내일 또 만나요, 크앙!"
    }
  ],
