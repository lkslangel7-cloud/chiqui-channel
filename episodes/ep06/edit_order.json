  "captions": [
    {
      "at": 0,
      "end": 3.6,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 3.6,
      "end": 6.0,
      "text": "뿔이 셋 치키 (치키!)"
    },
    {
      "at": 6.0,
      "end": 8.3,
      "text": "크앙 크앙 로로 (로로!)"
    },
    {
      "at": 8.3,
      "end": 10.8,
      "text": "목이 쭈욱 토롱 (토롱!)"
    },
    {
      "at": 10.8,
      "end": 13.2,
      "text": "하늘 슝슝 피오 (피오!)"
    },
    {
      "at": 13.2,
      "end": 15.3,
      "text": "안경 쓴 바우 할아버지 (허허!)"
    },
    {
      "at": 15.3,
      "end": 17.9,
      "text": "공룡 마을 친구들"
    },
    {
      "at": 17.9,
      "end": 20.3,
      "text": "치키치키 출발!"
    },
    {
      "at": 56.6,
      "end": 58.5,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 58.5,
      "end": 61.0,
      "text": "비누야 어디 있니? (어디 있니?)"
    },
    {
      "at": 61.0,
      "end": 63.1,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 63.1,
      "end": 64.9,
      "text": "치키치키 출발!"
    },
    {
      "at": 65.0,
      "end": 67.8,
      "text": "바위 뒤에 몽글몽글"
    },
    {
      "at": 67.8,
      "end": 69.9,
      "text": "크앙! 로로가 찾았다"
    },
    {
      "at": 69.9,
      "end": 74.3,
      "text": "노란 비누 찾았다 (비누!)"
    },
    {
      "at": 74.5,
      "end": 77.0,
      "text": "나무 위에 몽글몽글"
    },
    {
      "at": 77.0,
      "end": 79.2,
      "text": "쭈욱~ 토롱이 찾았다"
    },
    {
      "at": 79.2,
      "end": 83.5,
      "text": "초록 비누 찾았다 (비누!)"
    },
    {
      "at": 83.7,
      "end": 86.1,
      "text": "구름 위에 몽글몽글"
    },
    {
      "at": 86.1,
      "end": 88.2,
      "text": "슝~ 피오가 찾았다"
    },
    {
      "at": 88.2,
      "end": 92.6,
      "text": "파란 비누 찾았다 (비누!)"
    },
    {
      "at": 92.8,
      "end": 95.5,
      "text": "치키 비누 어디 있니?"
    },
    {
      "at": 95.5,
      "end": 97.7,
      "text": "두리번 두리번 (어디 있지?)"
    },
    {
      "at": 97.7,
      "end": 101.7,
      "text": "주황 주황 내 비누 (어디?)"
    },
    {
      "at": 102.1,
      "end": 104.3,
      "text": "쿵쿵 쾅! 쿵쿵 쾅!"
    },
    {
      "at": 104.3,
      "end": 106.9,
      "text": "비누야 어디 있니? (어디 있니?)"
    },
    {
      "at": 106.9,
      "end": 108.9,
      "text": "친구들아 같이 가자"
    },
    {
      "at": 108.9,
      "end": 111.5,
      "text": "치키치키 출발!"
    },
    {
      "at": 157.5,
      "end": 160.9,
      "text": "오늘도 재밌었지? (응!)"
    },
    {
      "at": 160.9,
      "end": 163.9,
      "text": "바우 할아버지도 (허허!)"
    },
    {
      "at": 163.9,
      "end": 168.9,
      "text": "안녕! 바이바이! 아디오스!"
